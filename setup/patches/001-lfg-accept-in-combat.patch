+        // fighting when the proposal arrived - and LFG drops decliners from the
+        // queue, so groups kept failing to form. Real players may accept mid-fight
+        // too. Instead of declining, the bot drops what it is doing and commits.
+        if (bot->isDead())
         {
             WorldPacket* packet = new WorldPacket(CMSG_LFG_PROPOSAL_RESULT);
             *packet << id << false;
@@ -209,6 +239,10 @@ bool LfgAcceptAction::Execute(Event event)
             return true;
         }
 
+        bot->CombatStop(true);
+        bot->AttackStop();
+        bot->InterruptNonMeleeSpells(true);
+
         botAI->GetAiObjectContext()->GetValue<uint32>("lfg proposal")->Set(0);
         bot->ClearUnitState(UNIT_STATE_ALL_STATE);
 
@@ -223,6 +257,11 @@ bool LfgAcceptAction::Execute(Event event)
         }
 
