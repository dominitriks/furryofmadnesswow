 using namespace lfg;
 
+namespace
+{
+    // PATCH (local): after a bot accepts an LFG proposal it is teleported into the
+    // dungeon immediately. Without a pause the bots charge in while a real player
+    // is still finishing a quest or a duel. Blocking the bot's AI for a few seconds
+    // makes them hold at the entrance instead.
+    //
+    // Tunable in playerbots.conf (milliseconds):
+    //     AiPlayerbot.LfgEnterDelayMin   default 25000
+    //     AiPlayerbot.LfgEnterDelayMax   default 50000
+    // Set both to 0 to restore the original charge-in-immediately behaviour.
+    void LfgDelayOnEnter(PlayerbotAI* botAI)
+    {
+        uint32 dmin = sConfigMgr->GetOption<uint32>("AiPlayerbot.LfgEnterDelayMin", 25000);
+        uint32 dmax = sConfigMgr->GetOption<uint32>("AiPlayerbot.LfgEnterDelayMax", 50000);
+
+        if (!dmax)
+            return;
+        if (dmin > dmax)
+            std::swap(dmin, dmax);
+
+        botAI->SetNextCheckDelay(urand(dmin, dmax));
+    }
+}
+
 bool LfgJoinAction::Execute(Event /*event*/) { return JoinLFG(); }
 
 uint32 LfgJoinAction::GetRoles()
